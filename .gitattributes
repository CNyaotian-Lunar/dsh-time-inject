# 统一换行符：源码/配置/文档 LF，Windows 批处理 CRLF
# eol=lf 优先级高于 core.autocrlf，checkout 出来就是 LF

* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf

